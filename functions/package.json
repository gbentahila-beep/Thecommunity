{
  "name": "@thecommunity/functions",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud Functions for Firebase (v2) — logique serveur sécurisée de The Community",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=lib/index.js --external:firebase-functions --external:firebase-admin --sourcemap",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@thecommunity/shared": "*",
    "esbuild": "0.28.2",
    "typescript": "^5",
    "zod": "^4.6.7"
  }
}
