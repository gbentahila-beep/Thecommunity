# Configuration web Firebase (publique). Laisser vide = mode démonstration (données fictives).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Émulateurs locaux (npm run emulators à la racine) : décommenter ces lignes.
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-thecommunity
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-thecommunity.appspot.com
# NEXT_PUBLIC_USE_EMULATORS=true
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
